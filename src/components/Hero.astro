---
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
---

<section class="gh-hero not-content" aria-labelledby="_top">
  <p class="gh-eyebrow">
    <span class="gh-dot" aria-hidden="true"></span>
    docs.i2bskn.com
  </p>
  <h1 id="_top" data-page-title set:html={title} />
  {tagline && <p class="gh-tagline" set:html={tagline} />}
</section>

<style>
  .gh-hero {
    padding-block: 1.5rem 2.5rem;
  }
  @media (min-width: 62rem) {
    .gh-hero {
      padding-block: 3.5rem 3.5rem;
    }
  }
  .gh-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }
  .gh-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
  }
  h1 {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(2.375rem, 1.6rem + 3.4vw, 4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .gh-tagline {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gh-hero > * {
      animation: gh-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .gh-hero > :nth-child(2) {
      animation-delay: 60ms;
    }
    .gh-hero > :nth-child(3) {
      animation-delay: 120ms;
    }
  }
  @keyframes gh-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
